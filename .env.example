# DryDock environment. Copy to .env.local (gitignored) and edit.

# SQLite database file. Lives outside the repo so it's never committed.
DRYDOCK_DB_PATH=~/.drydock/drydock.db

# ---------------------------------------------------------------------------
# Remote-access auth (EP-1). Requests from localhost never need auth; every
# non-local request (i.e. anything through the Cloudflare Tunnel) requires
# one of the modes below. With NEITHER configured, remote requests are
# refused entirely — fail closed.
#
# Mode 1 (recommended): Cloudflare Access in front of the tunnel.
# Set BOTH values; the middleware verifies the Cf-Access-Jwt-Assertion JWT.
#   CF_ACCESS_TEAM_DOMAIN — your team, e.g. "myteam" or
#                           "myteam.cloudflareaccess.com"
#   CF_ACCESS_AUD         — the Access application's Audience (AUD) tag
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Mode 2: single shared token. Enter it once on the phone at /auth (stored
# as an httpOnly cookie for 30 days) or send it as a Bearer header from
# scripts. Generate one with: openssl rand -base64 32
# DRYDOCK_AUTH_TOKEN=
# ---------------------------------------------------------------------------

# Dispatch stub for UAT — every dispatch resolves to a no-op provider.
# DRYDOCK_PROVIDER_STUB=1

# Agent subprocess hard timeout in milliseconds (default: 10 minutes).
# DRYDOCK_AGENT_TIMEOUT_MS=600000

# Project discovery root for /discover (default: ~/Documents/Projects).
# DRYDOCK_PROJECTS_ROOT=
